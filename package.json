{
  "name": "android-re-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "dev:standalone": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --workspace=@android-re/server\" \"npm run dev --workspace=@android-re/client\"",
    "build": "npm run build --workspaces --if-present && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@android-re/client && npm run typecheck --workspace=@android-re/server",
    "start": "node server.ts",
    "setup": "bash setup-codespace.sh",
    "clean": "rm -rf dist client/dist server/dist .logs .pids server/sessions",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.3",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
